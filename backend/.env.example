# NetSecure backend environment variables.
# Django reads these from the process environment (no .env loader is installed),
# so export them in your shell before running manage.py.

# 1/true/yes enables debug mode. Leave off outside local development.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames, e.g. localhost,127.0.0.1
# With DEBUG on and this empty, Django allows localhost only.
DJANGO_ALLOWED_HOSTS=

# 1/true/yes sends session and CSRF cookies over HTTPS only. Defaults to on
# when DJANGO_DEBUG is off; set 0 for a non-debug server on plain HTTP (lab VM).
DJANGO_SECURE_COOKIES=
